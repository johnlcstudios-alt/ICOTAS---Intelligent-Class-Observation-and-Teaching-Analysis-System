# Secrets and runtime artefacts
.env
.env.*
!.env.example

# Private runtime storage
storage/logs/*
!storage/logs/.gitkeep
storage/cache/*
!storage/cache/.gitkeep
storage/reports/*
!storage/reports/.gitkeep
storage/setup_token.txt

# Uploads and generated files
public/uploads/*
!public/uploads/.gitkeep

