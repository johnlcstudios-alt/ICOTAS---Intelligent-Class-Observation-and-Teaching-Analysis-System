# ICOTAS root .htaccess
# The only web-exposed directory is /public. Sensitive paths are denied
# and all other requests are internally forwarded into /public.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never expose source, configuration, database scripts or private storage.
    RewriteRule ^(app|config|database|routes|storage|tests|tools|docs)(/|$) - [F,L,NC]
    RewriteRule (^|/)\.(?!well-known) - [F,L]
    RewriteRule \.(env|sql|log|ini|lock)$ - [F,L,NC]

    # Forward to the public front controller.
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^$ public/index.php [L]
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
