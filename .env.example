# Copy this file to .env and fill in values for your installation.
# Never commit the real .env file.

APP_NAME="ICOTAS"
APP_ENV="production"
APP_DEBUG="false"
# Optional. Leave empty to auto-detect the application base path.
# Example: APP_URL="http://localhost/ICOTAS/public"
APP_URL=""

DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="icotas_db"
DB_USERNAME="icotas_app"
DB_PASSWORD="change-this-strong-password"

# 64 random hexadecimal characters (php -r "echo bin2hex(random_bytes(32));")
APP_KEY="change-this-64-character-random-key"
